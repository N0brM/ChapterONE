  "components": {
    "schemas": {
      "AddByUsernameRequest": {
        "type": "object",
        "properties": {
          "ProjectId": {
            "type": "integer",
            "format": "int32"
          },
          "RequestingUserId": {
            "type": "integer",
            "format": "int32"
          },
          "Username": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Chapter": {
        "required": [
          "Order",
          "ProjectId",
          "Title"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "ProjectId": {
            "type": "integer",
            "format": "int32"
          },
          "Title": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "Order": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "Content": {
            "type": "string",
            "nullable": true
          },
          "Project": {
            "$ref": "#/components/schemas/Project"
          },
          "WordCount": {
            "type": "integer",
            "format": "int32"
          },
          "ReadingTime": {
            "type": "integer",
            "format": "int32"
          },
          "PredominantEmotion": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "LastAnalysisDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ImproveRequest": {
        "type": "object",
        "properties": {
          "Text": {
            "type": "string",
            "nullable": true
          },
          "Type": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "JoinByCodeRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "integer",
            "format": "int32"
          },
          "Code": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string",
            "nullable": true
          },
          "PasswordHash": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Project": {
        "required": [
          "OwnerId",
          "Title"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Title": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "Description": {
            "type": "string",
            "nullable": true
          },
          "CreationDate": {
            "type": "string",
            "format": "date-time"
          },
          "OwnerId": {
            "type": "integer",
            "format": "int32"
          },
          "Owner": {
            "$ref": "#/components/schemas/User"
          },
          "CoverColor": {
            "maxLength": 7,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "CoverImage": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "ProjectType": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "InviteCode": {
            "maxLength": 8,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "Chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chapter"
            },
            "nullable": true
          },
          "Collaborators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectCollaborator"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProjectCollaborator": {
        "required": [
          "Role"
        ],
        "type": "object",
        "properties": {
          "ProjectId": {
            "type": "integer",
            "format": "int32"
          },
          "UserId": {
            "type": "integer",
            "format": "int32"
          },
          "Role": {
            "minLength": 1,
            "pattern": "admin|editor|viewer",
            "type": "string"
          },
          "Project": {
            "$ref": "#/components/schemas/Project"
          },
          "User": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "TextRequest": {
        "type": "object",
        "properties": {
          "Text": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string",
            "nullable": true
          },
          "Email": {
            "type": "string",
            "nullable": true
          },
          "PreferredTheme": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "Email",
          "PasswordHash",
          "Username"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Username": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "Email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "PasswordHash": {
            "minLength": 1,
            "type": "string"
          },
          "RegistrationDate": {
            "type": "string",
            "format": "date-time"
          },
          "PreferredTheme": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "ProfilePicture": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "OwnedProjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "nullable": true
          },
          "Collaborations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectCollaborator"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
